# Algo-Trading Hub Configuration
# Copy values into your deployment environment or local .env/.env.local file.
# Never commit real secrets.

# Application Settings
ALGOTRADING_APP_NAME=Algo-Trading Hub
ALGOTRADING_ENVIRONMENT=development
ALGOTRADING_DEBUG=false
ALGOTRADING_LOG_LEVEL=INFO

# API Server
ALGOTRADING_API_HOST=0.0.0.0
ALGOTRADING_API_PORT=8000
ALGOTRADING_API_KEY=replace-with-a-secure-random-api-key
ALGOTRADING_CORS_ORIGINS=["http://localhost:3000"]

# Interactive Brokers
ALGOTRADING_IB_HOST=127.0.0.1
ALGOTRADING_IB_PORT=7497
ALGOTRADING_IB_CLIENT_ID=1

# Alpaca
ALGOTRADING_ALPACA_API_KEY=
ALGOTRADING_ALPACA_SECRET_KEY=
ALGOTRADING_ALPACA_PAPER=true
ALGOTRADING_ALPACA_DATA_FEED=iex

# News Providers
ALGOTRADING_BENZINGA_API_KEY=
ALGOTRADING_ALPHAVANTAGE_API_KEY=
ALGOTRADING_NEWS_PROVIDER=benzinga
ALGOTRADING_NEWS_FALLBACK_PROVIDER=alphavantage

# OpenAI
ALGOTRADING_OPENAI_API_KEY=
ALGOTRADING_OPENAI_MODEL=gpt-4o-mini
ALGOTRADING_OPENAI_TIMEOUT_SECONDS=30

# Storage Paths
ALGOTRADING_DATA_PATH=data
ALGOTRADING_MODEL_PATH=models
ALGOTRADING_LOG_PATH=logs

# Trading Defaults
ALGOTRADING_DEFAULT_BROKER=interactive_brokers
ALGOTRADING_MAX_POSITION_PCT=0.1
ALGOTRADING_MIN_CONFIDENCE=0.6
