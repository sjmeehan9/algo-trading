# News API Credentials
# Copy this file to news_credentials.yml and fill in your API key values.
# DO NOT commit news_credentials.yml to version control.

primary_provider: benzinga
fallback_provider: alphavantage

benzinga:
  api_key: "${BENZINGA_API_KEY}"
  poll_interval_seconds: 10

alphavantage:
  api_key: "${ALPHAVANTAGE_API_KEY}"
  poll_interval_seconds: 60
